# HARNESS AI AGENTIC - Environment Template

PROJECT_NAME="HARNESS AI AGENTIC"
VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# API Keys (Replace with your actual keys)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# LLM Base URLs
DEEPSEEK_BASE_URL="https://api.deepseek.com"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# LLM Default Models
DEFAULT_DIRECTOR_MODEL="deepseek/deepseek-chat"
DEFAULT_SCENARIO_MODEL="google/gemini-2.5-flash"
DEFAULT_VISUAL_MODEL="qwen/qwen-2.5-72b-instruct"
